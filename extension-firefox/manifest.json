{

  "description": "Send tabs and links from Firefox to Chrome with a right-click. Requires the free Tab Ferry helper app for Windows.",
  "manifest_version": 3,
  "name": "Tab Ferry – Send to Chrome",
  "version": "1.2",
  "icons": {
    "48": "icons/replace.svg"
  },

  "browser_specific_settings": {
    "gecko": {
      "id": "tab-ferry@dzhang3210.github.io",
      "strict_min_version": "140.0",
      "data_collection_permissions": {"required":["none"]}
    }
  },

  "background": {
    "scripts": ["background.js"]
  },

  "action": {
    "default_icon":  "icons/replace.svg",
    "default_title": "Tab Ferry",
    "default_popup": "popup.html",
    "default_area": "navbar"
  },

  "permissions": ["nativeMessaging", "menus", "tabs"]
}