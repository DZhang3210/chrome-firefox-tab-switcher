{

  "description": "tab_transfer_code",
  "manifest_version": 3,
  "name": "Tab Transfer",
  "version": "1.2",
  "icons": {
    "48": "icons/replace.svg"
  },

  "browser_specific_settings": {
    "gecko": {
      "id": "tab_transfer@example.org",
      "strict_min_version": "109.0"
    }
  },

  "background": {
    "scripts": ["background.js"]
  },

  "action": {
    "default_icon":  "icons/replace.svg",
    "default_title": "install_helper",
    "default_popup": "popup.html"
  },

  "permissions": ["nativeMessaging", "menus", "tabs"]
}