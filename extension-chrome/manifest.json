{
  "manifest_version": 3,
  "name": "Tab Ferry – Send to Firefox",
  "description": "Send tabs and links from Chrome to Firefox with a right-click. Requires the free Tab Ferry helper app for Windows.",
  "version": "1.2",
  "background": { "service_worker": "background.js" },
  "icons": {
    "16": "icons/replace16.png",
    "32": "icons/replace32.png",
    "48": "icons/replace48.png",
    "128": "icons/replace128.png"
  },
   "action": {
    "default_icon": {
      "16": "icons/replace16.png",
      "32": "icons/replace32.png"
    },
    "default_title": "Tab Ferry",
    "default_popup": "popup.html"
  },


  "permissions": ["nativeMessaging", "contextMenus", "tabs"]
}